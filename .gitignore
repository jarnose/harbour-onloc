# sfdk's own per-checkout session state, not project config.
.sfdk/

# Packaged RPMs and compiled translations (qt5_add_translation's output
# lands at the project root for this in-source build, not under
# translations/) - both are build output, not source.
RPMS/
*.qm
.testhome/

# The daemon's RPM, copied here to be embedded in the application: a build
# product passing through, not source.
daemon/embed/
daemon-embed/

# Qt's generated resource source (the embedded daemon RPM as a byte array).
qrc_*.cpp
